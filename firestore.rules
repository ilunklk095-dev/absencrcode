rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Semua akun Firebase Authentication pada proyek ini dianggap admin aplikasi.
    // Jangan aktifkan pendaftaran umum. Buat akun admin hanya dari Firebase Console.
    match /students/{studentId} {
      allow read, create, update, delete: if signedIn();
    }

    match /attendance/{attendanceId} {
      allow read, create, update, delete: if signedIn();
    }

    match /settings/{settingId} {
      allow read, create, update, delete: if signedIn();
    }

    // Tolak koleksi lain yang tidak dipakai aplikasi.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
